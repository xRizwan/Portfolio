---
// Fixed header: the name, anchor links to each stop on the climb and the resume. On wide
// screens the altimeter dial sits in the right margin; narrower screens get the reading here.
import { site } from '../../../data/site';

const stops = [
  { label: 'Trailhead', href: '#about' },
  { label: 'Gear', href: '#skills' },
  { label: 'Camps', href: '#experience' },
  { label: 'Routes', href: '#work' },
  { label: 'Register', href: '#certificates' },
  { label: 'Summit', href: '#contact' },
];
---

<header class="mt-head" data-mt-head>
  <a class="mt-head-name" href="#top" aria-label={`${site.shortName}, back to the start`}>
    <svg viewBox="0 0 40 26" width="40" height="26" aria-hidden="true">
      <path d="M2 24 14 7l6 8 5-6 13 15" />
      <path class="mt-head-flag" d="M14 7V1l6 2-6 2" />
    </svg>
    <span>{site.shortName}</span>
  </a>
  <nav class="mt-head-nav" aria-label="On this page">
    <ul>
      {stops.map((stop) => (
        <li>
          <a href={stop.href}>{stop.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="mt-head-alt" aria-hidden="true">
    <span data-mt-alt-text>900</span> m
  </p>
  <a class="mt-head-resume" href={site.resume}>
    Resume
  </a>
</header>

<!-- Altimeter: a drawn dial whose needle and reading rise with the scroll. Decorative. -->
<div class="mt-alt" aria-hidden="true">
  <svg viewBox="0 0 120 120" width="120" height="120">
    <circle class="mt-alt-face" cx="60" cy="60" r="52"></circle>
    <circle class="mt-alt-rim" cx="60" cy="60" r="56"></circle>
    {Array.from({ length: 24 }, (_, index) => {
      const angle = (index / 24) * Math.PI * 2;
      const inner = index % 4 === 0 ? 40 : 45;
      return (
        <line
          x1={60 + Math.sin(angle) * inner}
          y1={60 - Math.cos(angle) * inner}
          x2={60 + Math.sin(angle) * 49}
          y2={60 - Math.cos(angle) * 49}
        />
      );
    })}
    <g class="mt-alt-needle" data-mt-needle>
      <path d="M60 64 58 26l2-8 2 8z"></path>
      <circle cx="60" cy="60" r="4"></circle>
    </g>
  </svg>
  <span class="mt-alt-read">
    <span data-mt-alt-text>900</span> m
  </span>
  <span class="mt-alt-note">altitude</span>
</div>

<style is:global>
  .lab-mountain .mt-head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    padding: 14px clamp(16px, 3vw, 36px);
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  .lab-mountain .mt-head.is-scrolled {
    background: var(--mt-grain), rgb(245 236 215 / 94%);
    box-shadow: 0 1px 0 rgb(80 60 30 / 18%);
  }
  .lab-mountain .mt-head-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 24px/1 var(--mt-serif);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .lab-mountain .mt-head-name svg {
    fill: none;
    stroke: var(--mt-ink);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .lab-mountain .mt-head-name .mt-head-flag {
    stroke: var(--mt-red);
    fill: var(--mt-red);
  }
  .lab-mountain .mt-head-nav {
    margin-left: auto;
  }
  .lab-mountain .mt-head-nav ul {
    display: flex;
    gap: 4px;
  }
  .lab-mountain .mt-head-nav a {
    display: block;
    padding: 8px 10px;
    font: 400 12px/1 var(--mt-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
  }
  .lab-mountain .mt-head-nav a:hover {
    background: rgb(31 42 54 / 9%);
    color: var(--mt-red-ink);
  }
  .lab-mountain .mt-head-alt {
    display: none;
    font: 700 12px/1 var(--mt-mono);
    color: var(--mt-graphite);
    white-space: nowrap;
  }
  .lab-mountain .mt-head-resume {
    padding: 9px 16px 10px;
    border-radius: 999px;
    background: var(--mt-ink);
    color: var(--mt-snow);
    font: 700 12px/1 var(--mt-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }
  .lab-mountain .mt-head-resume:hover {
    background: var(--mt-red);
  }

  /* The dial lives in the right margin, so it never covers text. */
  .lab-mountain .mt-alt {
    position: fixed;
    right: max(16px, calc(var(--mt-margin) / 2 - 60px));
    bottom: 86px;
    z-index: 90;
    display: grid;
    justify-items: center;
    width: 120px;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    pointer-events: none;
  }
  .lab-mountain.mt-climbing .mt-alt {
    opacity: 1;
    transform: none;
  }
  /* Out of the way of the footer links. */
  .lab-mountain.mt-climbing.mt-at-foot .mt-alt {
    opacity: 0;
    transform: translateY(14px);
  }
  .lab-mountain .mt-alt svg {
    filter: drop-shadow(0 6px 8px rgb(30 40 50 / 22%));
  }
  .lab-mountain .mt-alt-face {
    fill: #fbf4e3;
    stroke: var(--mt-graphite);
    stroke-width: 1.2;
  }
  .lab-mountain .mt-alt-rim {
    fill: none;
    stroke: #8a6c3b;
    stroke-width: 5;
    stroke-dasharray: 2 2.6;
  }
  .lab-mountain .mt-alt line {
    stroke: var(--mt-graphite);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .lab-mountain .mt-alt-needle {
    fill: var(--mt-red);
    transform-origin: 60px 60px;
    transition: transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .lab-mountain .mt-alt-read {
    position: relative;
    margin-top: -48px;
    font: 700 12px/1 var(--mt-mono);
    color: var(--mt-ink);
  }
  .lab-mountain .mt-alt-note {
    margin-top: 34px;
    padding: 2px 8px;
    background: var(--mt-grain), var(--mt-paper);
    font: 700 18px/1 var(--mt-hand);
    color: var(--mt-graphite);
    transform: rotate(-4deg);
  }

  @media (max-width: 1279px) {
    .lab-mountain .mt-alt {
      display: none;
    }
    .mt-js .lab-mountain.mt-climbing .mt-head-alt {
      display: block;
    }
  }
  @media (max-width: 980px) {
    .lab-mountain .mt-head {
      flex-wrap: wrap;
      row-gap: 6px;
      padding-block: 10px 6px;
    }
    .lab-mountain .mt-head-alt {
      margin-left: auto;
    }
    .lab-mountain .mt-head-resume {
      margin-left: auto;
    }
    .mt-js .lab-mountain.mt-climbing .mt-head-alt + .mt-head-resume {
      margin-left: 0;
    }
    /* The links move to their own scrolling row under the name. */
    .lab-mountain .mt-head-nav {
      order: 5;
      flex: 1 0 100%;
      margin: 0 -10px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .lab-mountain .mt-head-nav a {
      padding: 7px 9px;
      font-size: 11px;
    }
  }
</style>
