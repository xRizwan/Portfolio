---
// Certificates: the summit register, where each course is a stamp (or, for badges, a sewn-on
// patch) pressed into the book. Picking one up opens it large in a dialog with previous and
// next (register.ts). Without scripts each stamp links straight to the full image.
import { Image, getImage } from 'astro:assets';
import { credentialAlt, credentials } from '../../../data/certificates';
import MtLedges from './MtLedges.astro';

const entries = await Promise.all(
  credentials.map(async (credential) => ({
    credential,
    full: await getImage({
      src: credential.image,
      width: Math.min(1500, credential.image.width),
      format: 'webp',
    }),
  })),
);
// Pressed in by hand: tilts repeat on a short cycle.
const tilts = [-3, 2.4, -1.2, 3.2, -2.2, 1.4, -3.4, 0.8];
---

<section class="mt-section mt-register" id="certificates" aria-labelledby="mt-register-title">
  <MtLedges />
  <div class="mt-wrap">
    <p class="mt-place">The summit register</p>
    <h2 class="mt-h2" id="mt-register-title">
      Courses I <em>signed off</em>
    </h2>
    <p class="mt-pencil mt-register-hint">
      Each one is a stamp in the book. Pick one up to look closer.
    </p>

    <div class="mt-book mt-paper">
      <span class="mt-book-ribbon" aria-hidden="true"></span>
      <ul class="mt-stamps">
        {entries.map(({ credential, full }, index) => (
          <li
            class:list={['mt-stamp-entry', credential.kind === 'badge' && 'is-badge']}
            data-reveal
            style={{
              '--reveal-i': index % 5,
              '--reveal-tilt': `${(tilts[index % tilts.length] ?? 0) * 4}deg`,
              '--reveal-rest': `${tilts[index % tilts.length] ?? 0}deg`,
            }}
          >
            <a
              class="mt-stamp"
              href={full.src}
              data-mt-stamp
              data-title={credential.title}
              data-issuer={credential.issuer}
              data-alt={credentialAlt(credential)}
            >
              <span class="mt-stamp-lift">
                <span class="mt-stamp-face">
                  <Image
                    src={credential.image}
                    alt={credentialAlt(credential)}
                    width={credential.kind === 'badge' ? 220 : 360}
                    loading="lazy"
                  />
                  <svg class="mt-stamp-mark" viewBox="0 0 100 60" aria-hidden="true">
                    <circle cx="28" cy="30" r="22" />
                    <circle cx="28" cy="30" r="17" />
                    <path d="M54 18c10-4 20 4 30 0s12-2 14-1M54 30c10-4 20 4 30 0s12-2 14-1M54 42c10-4 20 4 30 0s12-2 14-1" />
                  </svg>
                </span>
              </span>
              <span class="mt-stamp-line">
                <strong>{credential.title}</strong>
                <span>{credential.issuer}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dialog class="mt-viewer" data-mt-viewer aria-labelledby="mt-viewer-title">
    <div class="mt-viewer-card mt-paper">
      <div class="mt-viewer-frame">
        <img data-mt-viewer-img src="" alt="" />
      </div>
      <p class="mt-viewer-caption">
        <strong id="mt-viewer-title" data-mt-viewer-title></strong>
        <span data-mt-viewer-issuer></span>
      </p>
      <div class="mt-viewer-controls">
        <button type="button" data-mt-viewer-prev>
          Previous
        </button>
        <button type="button" data-mt-viewer-close>
          Put it back
        </button>
        <button type="button" data-mt-viewer-next>
          Next
        </button>
      </div>
    </div>
  </dialog>
</section>

<style is:global>
  .lab-mountain .mt-register-hint {
    margin-top: 14px;
  }
  /* The register: a lined page with a red ribbon marker. */
  .lab-mountain .mt-book {
    margin-top: clamp(40px, 6vh, 64px);
    padding: clamp(34px, 4vw, 60px) clamp(18px, 3.4vw, 54px) clamp(40px, 4.6vw, 64px);
    background:
      var(--mt-grain),
      repeating-linear-gradient(180deg, transparent 0 33px, rgb(110 140 170 / 22%) 33px 34px),
      linear-gradient(
        90deg,
        transparent 58px,
        rgb(226 85 47 / 28%) 58px 59.5px,
        transparent 59.5px
      ),
      radial-gradient(120% 90% at 30% 20%, #fdf9ef 0%, #f3ead6 70%, #e9dcc0 100%);
  }
  .lab-mountain .mt-book-ribbon {
    position: absolute;
    top: -10px;
    right: 12%;
    width: 22px;
    height: 120px;
    background: linear-gradient(90deg, #c8431f, var(--mt-red) 40%, #c8431f);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 86%, 0 100%);
    box-shadow: 0 4px 6px rgb(0 0 0 / 15%);
  }
  .lab-mountain .mt-stamps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(26px, 3vw, 44px) clamp(20px, 2.6vw, 38px);
  }
  .lab-mountain .mt-stamp-entry {
    width: clamp(150px, 15vw, 200px);
  }
  .lab-mountain .mt-stamp-entry.is-badge {
    width: clamp(120px, 11vw, 150px);
  }
  .lab-mountain .mt-stamp {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  /* A postage stamp: white paper with perforated edges. The first mask layer punches holes
     everywhere, the second fills the middle back in, so only the border is perforated. */
  .lab-mountain .mt-stamp-face {
    position: relative;
    display: block;
    padding: 11px;
    background: #fffdf7;
    -webkit-mask:
      radial-gradient(circle 4px at center, #0000 96%, #000) -6px -6px / 12px 12px round,
      linear-gradient(#000 0 0) 6px 6px / calc(100% - 12px) calc(100% - 12px) no-repeat;
    mask:
      radial-gradient(circle 4px at center, #0000 96%, #000) -6px -6px / 12px 12px round,
      linear-gradient(#000 0 0) 6px 6px / calc(100% - 12px) calc(100% - 12px) no-repeat;
  }
  /* The shadow sits on a wrapper: a mask would cut away a shadow on the stamp itself. */
  .lab-mountain .mt-stamp-lift {
    display: block;
    filter: drop-shadow(0 6px 6px rgb(40 34 20 / 24%));
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .lab-mountain .mt-stamp-face img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
    filter: sepia(0.12);
  }
  /* A postmark half on the stamp, in the expedition red. */
  .lab-mountain .mt-stamp-mark {
    position: absolute;
    right: 6px;
    bottom: 8px;
    width: 52%;
    fill: none;
    stroke: rgb(226 85 47 / 50%);
    stroke-width: 2;
    stroke-linecap: round;
    transform: rotate(-14deg);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .lab-mountain .is-badge .mt-stamp-face {
    padding: 10px;
    border-radius: 50%;
    background: var(--mt-snow);
    -webkit-mask: none;
    mask: none;
    outline: 2.5px dashed rgb(29 53 87 / 55%);
    outline-offset: -7px;
  }
  .lab-mountain .is-badge .mt-stamp-face img {
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 50%;
    filter: none;
  }
  .lab-mountain .is-badge .mt-stamp-mark {
    display: none;
  }
  .lab-mountain .mt-stamp:hover .mt-stamp-lift,
  .lab-mountain .mt-stamp:focus-visible .mt-stamp-lift {
    transform: translateY(-8px) rotate(-3deg) scale(1.05);
  }
  .lab-mountain .mt-stamp-line {
    display: grid;
    gap: 2px;
    text-align: center;
  }
  .lab-mountain .mt-stamp-line strong {
    font: 500 16px/1.25 var(--mt-serif);
  }
  .lab-mountain .mt-stamp-line span {
    color: var(--mt-graphite);
    font: 700 18px/1.1 var(--mt-hand);
  }

  /* The enlarged stamp. */
  .lab-mountain .mt-viewer {
    width: min(980px, 100vw - 24px);
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .lab-mountain .mt-viewer::backdrop {
    background: rgb(22 34 52 / 78%);
    backdrop-filter: blur(3px);
  }
  .lab-mountain .mt-viewer[open] {
    animation: mt-viewer-in 0.45s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  @keyframes mt-viewer-in {
    from {
      opacity: 0;
      transform: translateY(30px) rotate(-3deg) scale(0.92);
    }
  }
  .lab-mountain .mt-viewer-card {
    display: grid;
    gap: 14px;
    padding: clamp(14px, 2vw, 24px);
    max-height: calc(100dvh - 24px);
  }
  .lab-mountain .mt-viewer-frame {
    display: grid;
    place-items: center;
    min-height: 0;
  }
  .lab-mountain .mt-viewer-frame img {
    max-height: calc(100dvh - 190px);
    width: auto;
    margin-inline: auto;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 40%);
  }
  .lab-mountain .mt-viewer-caption {
    display: grid;
    gap: 2px;
    text-align: center;
  }
  .lab-mountain .mt-viewer-caption strong {
    font: 500 clamp(19px, 2vw, 24px) / 1.2 var(--mt-serif);
  }
  .lab-mountain .mt-viewer-caption span {
    color: var(--mt-graphite);
    font: 700 20px/1.1 var(--mt-hand);
  }
  .lab-mountain .mt-viewer-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .lab-mountain .mt-viewer-controls button {
    padding: 10px 16px 11px;
    border: 2px solid var(--mt-ink);
    border-radius: 999px;
    background: transparent;
    font: 700 12px/1 var(--mt-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lab-mountain .mt-viewer-controls button:hover {
    background: var(--mt-ink);
    color: var(--mt-snow);
  }

  @media (max-width: 560px) {
    .lab-mountain .mt-book {
      background:
        var(--mt-grain),
        repeating-linear-gradient(180deg, transparent 0 33px, rgb(110 140 170 / 22%) 33px 34px),
        radial-gradient(120% 90% at 30% 20%, #fdf9ef 0%, #f3ead6 70%, #e9dcc0 100%);
    }
    .lab-mountain .mt-stamps {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 26px 14px;
    }
    .lab-mountain .mt-stamp-entry,
    .lab-mountain .mt-stamp-entry.is-badge {
      width: auto;
    }
    .lab-mountain .is-badge .mt-stamp-face {
      width: 82%;
      margin-inline: auto;
    }
    .lab-mountain .mt-stamp-line strong {
      font-size: 15px;
    }
  }
</style>
