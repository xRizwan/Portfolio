---
// Skills: the gear laid out on a groundsheet before the climb, one item per skill group.
// Picking an item up shows that group's packing list (gear.ts). Without scripts every list is
// shown and each item links to its own list.
import { skillGroups } from '../../../data/skills';
import MtLedges from './MtLedges.astro';

interface Kit {
  src: string;
  width: number;
  height: number;
  /** What the sketch shows, for the item's accessible name. */
  thing: string;
}
// Which piece of gear stands for which group: the closest fit by use.
const kits: Record<string, Kit> = {
  languages: { src: 'notebook', width: 300, height: 294, thing: 'notebook' },
  interfaces: { src: 'map', width: 300, height: 222, thing: 'map' },
  backend: { src: 'rope', width: 300, height: 244, thing: 'rope' },
  data: { src: 'flask', width: 259, height: 300, thing: 'flask' },
  cloud: { src: 'binoculars', width: 300, height: 237, thing: 'binoculars' },
  ml: { src: 'compass', width: 249, height: 300, thing: 'compass' },
  quality: { src: 'carabiner', width: 213, height: 300, thing: 'carabiner' },
  agents: { src: 'headlamp', width: 300, height: 200, thing: 'headlamp' },
  architecture: { src: 'iceaxe', width: 253, height: 300, thing: 'ice axe' },
  design: { src: 'boots', width: 300, height: 255, thing: 'boots' },
  games: { src: 'lantern', width: 196, height: 300, thing: 'lantern' },
};
const fallback: Kit = { src: 'mug', width: 300, height: 256, thing: 'mug' };
// Laid down by hand: tilts repeat on a short cycle so the rows do not look ruled.
const tilts = [-8, 5, -3, 9, -6, 3, -10, 6, -4, 8, -2];
const groups = skillGroups.map((group, index) => ({
  ...group,
  kit: kits[group.id] ?? fallback,
  tilt: tilts[index % tilts.length] ?? 0,
}));
const first = groups[0]?.id;
---

<section class="mt-section mt-gear" id="skills" aria-labelledby="mt-gear-title" data-mt-gear>
  <MtLedges />
  <div class="mt-wrap">
    <p class="mt-place">Packing</p>
    <h2 class="mt-h2" id="mt-gear-title">
      The gear I <em>carry up</em>
    </h2>
    <p class="mt-pencil mt-gear-hint">
      Everything I work with, packed by kind. Pick something up to see what's in it.
    </p>

    <div class="mt-gear-layout">
      <ul class="mt-gear-sheet" aria-label="Skill groups">
        {groups.map((group, index) => (
          <li
            data-reveal
            style={{
              '--reveal-i': index % 6,
              '--reveal-tilt': `${group.tilt * 2}deg`,
              '--reveal-rest': '0deg',
            }}
          >
            <a
              class="mt-kit"
              href={`#pack-${group.id}`}
              data-mt-kit={group.id}
              aria-current={group.id === first ? 'true' : undefined}
              style={{ '--tilt': `${group.tilt}deg` }}
            >
              <span class="mt-kit-art">
                <img
                  src={`/lab/mountain/${group.kit.src}.webp`}
                  width={group.kit.width}
                  height={group.kit.height}
                  alt=""
                  loading="lazy"
                />
              </span>
              <span class="mt-kit-tag">{group.title}</span>
              <span class="mt-sr">
                , the {group.kit.thing}: show the {group.name} list
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-pack-card mt-paper mt-tape" aria-live="polite">
        <img
          class="mt-pack-mug"
          src="/lab/mountain/mug.webp"
          width="300"
          height="256"
          alt=""
          loading="lazy"
        />
        {groups.map((group) => (
          <article class="mt-pack" id={`pack-${group.id}`} data-mt-pack={group.id}>
            <p class="mt-pack-kicker">Packed in the {group.kit.thing}</p>
            <h3>{group.name}</h3>
            {group.context && <p class="mt-pack-context">{group.context}</p>}
            <ul>
              {group.items.map((item, index) => (
                <li style={{ '--i': index }}>
                  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                    <path
                      class="mt-pack-box"
                      d="M3 4c5-1 10-1 14 0 1 4 1 9 0 13-5 1-9 1-14 0-1-4-1-9 0-13Z"
                    />
                    <path class="mt-pack-tick" d="M5 10l4 4 8-11" pathLength="1" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .lab-mountain .mt-gear-hint {
    margin-top: 14px;
    max-width: 34em;
  }
  .lab-mountain .mt-gear-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 1fr);
    gap: clamp(28px, 4vw, 60px);
    align-items: start;
    margin-top: clamp(36px, 5vh, 56px);
  }

  /* The groundsheet: a canvas tarp with stitched edges. */
  .lab-mountain .mt-gear-sheet {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 6px;
    padding: clamp(20px, 2.6vw, 34px);
    border-radius: 8px 14px 10px 16px;
    background:
      var(--mt-grain),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 4%) 0 2px, transparent 2px 5px),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 4%) 0 2px, transparent 2px 6px),
      linear-gradient(160deg, #c9c2a5, #b7b294);
    box-shadow:
      inset 0 0 0 8px rgb(255 255 255 / 0%),
      inset 0 0 0 10px rgb(90 80 50 / 0%),
      0 22px 30px -20px rgb(40 50 30 / 55%);
    outline: 2px dashed rgb(80 70 45 / 35%);
    outline-offset: -12px;
  }
  .lab-mountain .mt-kit {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: end;
    gap: 6px;
    min-height: 150px;
    padding: 10px 4px 8px;
    text-decoration: none;
    border-radius: 12px;
    transform: rotate(var(--tilt));
    transition:
      transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1),
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  .lab-mountain .mt-kit-art {
    display: grid;
    place-items: center;
    width: 100%;
    height: 104px;
  }
  .lab-mountain .mt-kit-art img {
    max-width: min(112px, 92%);
    max-height: 104px;
    width: auto;
    transition: transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .lab-mountain .mt-kit-tag {
    position: relative;
    padding: 2px 10px 3px;
    background: var(--mt-grain), #fbf4e3;
    box-shadow: 0 2px 4px rgb(40 34 20 / 25%);
    color: var(--mt-ink);
    font: 700 19px/1.05 var(--mt-hand);
    text-align: center;
    clip-path: polygon(10px 0, 100% 0, 100% 100%, 10px 100%, 0 50%);
    padding-left: 16px;
  }
  .lab-mountain .mt-kit:hover,
  .lab-mountain .mt-kit:focus-visible {
    transform: rotate(calc(var(--tilt) * 0.4)) translateY(-4px);
  }
  /* Picked up: lifted off the tarp, the tag turns red. */
  .lab-mountain .mt-kit[aria-current='true'] {
    transform: rotate(0deg) translateY(-10px) scale(1.08);
  }
  .lab-mountain .mt-kit[aria-current='true'] .mt-kit-art img {
    transform: scale(1.12) rotate(-4deg);
  }
  .lab-mountain .mt-kit[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 34px;
    height: 16px;
    border-radius: 50%;
    background: rgb(40 40 20 / 22%);
    filter: blur(6px);
    z-index: -1;
  }
  .lab-mountain .mt-kit[aria-current='true'] .mt-kit-tag {
    background: var(--mt-red);
    color: #fff8ef;
  }
  .mt-js
    .lab-mountain
    .mt-gear-sheet:has([aria-current='true'])
    .mt-kit:not([aria-current='true']) {
    opacity: 0.82;
  }

  /* The packing list. Sticky beside the tarp on wide screens. */
  .lab-mountain .mt-pack-card {
    position: sticky;
    top: 110px;
    padding: 30px clamp(22px, 2.6vw, 34px) 34px;
    rotate: 1.2deg;
  }
  .lab-mountain .mt-pack-mug {
    position: absolute;
    right: -26px;
    bottom: -30px;
    width: 92px;
    rotate: 8deg;
    pointer-events: none;
  }
  .lab-mountain .mt-pack + .mt-pack {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1.5px dashed rgb(74 79 87 / 40%);
  }
  .lab-mountain .mt-pack-kicker {
    color: var(--mt-graphite);
    font: 400 11px/1.2 var(--mt-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lab-mountain .mt-pack h3 {
    margin-top: 6px;
    font: 500 clamp(30px, 2.8vw, 40px) / 1.02 var(--mt-serif);
    letter-spacing: -0.015em;
  }
  .lab-mountain .mt-pack-context {
    margin-top: 6px;
    font-style: italic;
  }
  .lab-mountain .mt-pack ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 6px 16px;
    margin-top: 18px;
  }
  .lab-mountain .mt-pack li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    line-height: 1.25;
  }
  .lab-mountain .mt-pack li svg {
    flex: none;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lab-mountain .mt-pack-box {
    stroke: var(--mt-graphite);
    stroke-width: 1.3;
  }
  .lab-mountain .mt-pack-tick {
    stroke: var(--mt-red);
    stroke-width: 2.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* With scripts, only the picked-up list shows, and its ticks are pencilled in one by one. */
  .mt-js .lab-mountain .mt-pack[hidden] {
    display: none;
  }
  .mt-js .lab-mountain .mt-pack + .mt-pack {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .mt-js .lab-mountain .mt-pack.is-fresh .mt-pack-tick {
    animation: mt-tick 0.35s ease-out both;
    animation-delay: calc(0.15s + var(--i) * 0.05s);
  }
  .mt-js .lab-mountain .mt-pack.is-fresh li {
    animation: mt-pack-in 0.4s ease-out both;
    animation-delay: calc(var(--i) * 0.04s);
  }
  @keyframes mt-tick {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes mt-pack-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  @media (max-width: 980px) {
    .lab-mountain .mt-gear-layout {
      grid-template-columns: 1fr;
    }
    .lab-mountain .mt-pack-card {
      position: relative;
      top: auto;
      rotate: 0.6deg;
    }
  }
  @media (max-width: 560px) {
    .lab-mountain .mt-gear-sheet {
      grid-template-columns: repeat(3, 1fr);
      padding: 18px 10px;
      gap: 4px 2px;
    }
    .lab-mountain .mt-kit {
      min-height: 124px;
    }
    .lab-mountain .mt-kit-art {
      height: 78px;
    }
    .lab-mountain .mt-kit-art img {
      max-height: 78px;
      max-width: 84px;
    }
    .lab-mountain .mt-kit-tag {
      font-size: 16px;
      padding: 2px 6px 3px 12px;
    }
    .lab-mountain .mt-pack-mug {
      width: 70px;
      right: -8px;
    }
  }
</style>
