---
// About: the first journal spread, written at the trailhead. The hut sketch develops like a
// wash drying as the spread scrolls in, and the three traits are pencilled into the margin.
import { experienceIntro } from '../../../data/experience';
import MtLedges from './MtLedges.astro';

const { about } = experienceIntro;
// A small pencil mark beside each trait, chosen to suit it.
const marks = [
  // Always learning: an open book.
  'M4 8c6-3 11-3 16 1v15c-5-4-10-4-16-1zM20 9c5-4 10-4 16-1v15c-6-3-11-3-16 1',
  // Hard problems: a steep face with a flag.
  'M3 25 15 6l5 7 4-5 13 17M15 6V0l6 2-6 2',
  // Digging for answers: a lantern.
  'M14 4h12M16 4v3h8V4M13 9h14l-2 15H15zM20 13v6M10 26h20',
];
---

<section class="mt-section mt-trail" id="about" aria-labelledby="mt-about-title">
  <MtLedges />
  <div class="mt-wrap">
    <p class="mt-place">The trailhead</p>
    <h2 class="mt-h2" id="mt-about-title">
      Before the climb, <em>a bit about me</em>
    </h2>

    <div class="mt-spread mt-paper" data-reveal style="--reveal-rest: -0.6deg">
      <div class="mt-spread-page mt-spread-page--left">
        <figure class="mt-trail-sketch" data-mt-develop>
          <img
            src="/lab/mountain/hut.webp"
            width="1100"
            height="679"
            alt="Watercolour sketch of a stone hut at the start of a mountain path, with a signpost and pines"
            loading="lazy"
          />
          <figcaption class="mt-pencil">Where the path starts. Kettle on, boots laced.</figcaption>
        </figure>
        <p class="mt-trail-lead">{about.lead}</p>
      </div>
      <div class="mt-spread-page mt-spread-page--right">
        <p class="mt-trail-body">{about.body}</p>
        <ul class="mt-trail-traits">
          {about.traits.map((trait, index) => (
            <li data-reveal style={{ '--reveal-i': index + 2, '--reveal-tilt': '-2deg' }}>
              <svg viewBox="0 0 40 28" width="40" height="28" aria-hidden="true">
                <path d={marks[index % marks.length]} />
              </svg>
              <div>
                <h3>{trait.title}</h3>
                <p>{trait.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <span class="mt-spread-gutter" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style is:global>
  .lab-mountain .mt-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(40px, 6vh, 64px);
    border-radius: 4px 10px 10px 4px;
  }
  /* The fold between the two pages. */
  .lab-mountain .mt-spread-gutter {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 60px;
    transform: translateX(-50%);
    background: linear-gradient(
      90deg,
      transparent,
      rgb(90 70 40 / 10%) 42%,
      rgb(90 70 40 / 22%) 50%,
      rgb(90 70 40 / 10%) 58%,
      transparent
    );
    pointer-events: none;
  }
  .lab-mountain .mt-spread-page {
    padding: clamp(28px, 4vw, 56px);
  }
  .lab-mountain .mt-trail-sketch img {
    width: 100%;
  }
  .lab-mountain .mt-trail-sketch figcaption {
    margin-top: 4px;
    transform: rotate(-1.5deg);
  }
  /* The sketch "develops": a soft wipe reveals it as the spread scrolls in (life.ts sets
     --develop from 0 to 1). Without scripts --develop stays at 1. */
  .lab-mountain [data-mt-develop] img {
    --develop: 1;
    -webkit-mask-image: linear-gradient(
      100deg,
      #000 calc(var(--develop) * 130% - 30%),
      transparent calc(var(--develop) * 130%)
    );
    mask-image: linear-gradient(
      100deg,
      #000 calc(var(--develop) * 130% - 30%),
      transparent calc(var(--develop) * 130%)
    );
  }
  .lab-mountain .mt-trail-lead {
    margin-top: 22px;
    font: italic 500 clamp(26px, 2.6vw, 36px) / 1.2 var(--mt-serif);
    text-wrap: balance;
  }
  .lab-mountain .mt-trail-body {
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.65;
  }
  .lab-mountain .mt-trail-body::first-letter {
    float: left;
    margin: 6px 8px 0 0;
    color: var(--mt-red-ink);
    font: 600 64px/0.8 var(--mt-serif);
  }
  .lab-mountain .mt-trail-traits {
    display: grid;
    gap: 18px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1.5px dashed rgb(74 79 87 / 45%);
  }
  .lab-mountain .mt-trail-traits li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: start;
  }
  .lab-mountain .mt-trail-traits svg {
    margin-top: 4px;
    fill: none;
    stroke: var(--mt-red);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lab-mountain .mt-trail-traits h3 {
    font: 700 clamp(25px, 2.2vw, 30px) / 1 var(--mt-hand);
    color: var(--mt-ink);
  }
  .lab-mountain .mt-trail-traits p {
    margin-top: 2px;
    color: #3a414b;
    font-size: 17px;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .lab-mountain .mt-spread {
      grid-template-columns: 1fr;
    }
    .lab-mountain .mt-spread-gutter {
      display: none;
    }
    .lab-mountain .mt-spread-page--right {
      padding-top: 0;
    }
    .lab-mountain .mt-spread-page {
      padding: 24px 20px;
    }
  }
</style>
