---
// A small floating bar: name, section links, resume. It is the same dark pill over the sunset, the
// night sky and the cream paper, so it never needs to change colour.
import { site } from '../../../data/site';

const links = [
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Work', href: '#work' },
  { label: 'Experience', href: '#experience' },
  { label: 'Certificates', href: '#certificates' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sp-header">
  <a class="sp-header-name" href="#main" aria-label={`${site.name}, back to the top`}>
    <span class="sp-header-dot" aria-hidden="true"></span>
    {site.shortName}
  </a>
  <nav class="sp-header-nav" aria-label="Sections">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <a class="sp-header-resume" href={site.resume}>
    Resume
  </a>
</header>

<style is:global>
  .lab-space .sp-header {
    position: fixed;
    top: 14px;
    left: 50%;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: calc(100vw - 20px);
    padding: 6px 6px 6px 16px;
    border: 2px solid var(--sp-cream);
    border-radius: 999px;
    background: var(--sp-space);
    box-shadow: 4px 4px 0 rgb(228 87 46 / 90%);
    transform: translateX(-50%);
    font: 700 13px/1 var(--sp-mono);
  }
  .lab-space .sp-header a {
    text-decoration: none;
    white-space: nowrap;
  }
  .lab-space .sp-header-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 10px;
    font: 800 20px/1 var(--sp-display);
    letter-spacing: -0.02em;
  }
  .lab-space .sp-header-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--sp-mustard);
    box-shadow: inset -4px -3px 0 var(--sp-tomato);
  }
  .lab-space .sp-header-nav {
    display: flex;
    gap: 2px;
  }
  .lab-space .sp-header-nav a {
    padding: 10px 11px;
    border-radius: 999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .lab-space .sp-header-nav a:hover {
    background: var(--sp-cream);
    color: var(--sp-ink);
  }
  .lab-space .sp-header-resume {
    margin-left: 6px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--sp-mustard);
    color: var(--sp-ink);
    transition: background-color 0.2s ease;
  }
  .lab-space .sp-header-resume:hover {
    background: var(--sp-cream);
  }
  .lab-space .sp-header :focus-visible {
    border-radius: 999px;
  }
  /* On a phone there is room for the name, three links and the resume. */
  @media (max-width: 900px) {
    .lab-space .sp-header-nav a:nth-child(1),
    .lab-space .sp-header-nav a:nth-child(4),
    .lab-space .sp-header-nav a:nth-child(5) {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .lab-space .sp-header {
      padding-left: 12px;
      font-size: 12px;
    }
    .lab-space .sp-header-name {
      margin-right: 2px;
      font-size: 17px;
    }
    .lab-space .sp-header-dot {
      display: none;
    }
    .lab-space .sp-header-nav a {
      padding: 9px 7px;
    }
    .lab-space .sp-header-resume {
      margin-left: 2px;
      padding: 9px 11px;
    }
  }
</style>
