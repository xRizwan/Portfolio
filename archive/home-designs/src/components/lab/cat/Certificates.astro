---
// Certificates: frames hung on the evening wall. Each one opens in a dialog for a closer look,
// and the calico comes to sit on the enlarged frame (certificates.ts). Without scripts each
// frame is a plain link to the full image.
import { Image, getImage } from 'astro:assets';
import { credentialAlt, credentials } from '../../../data/certificates';

const items = await Promise.all(
  credentials.map(async (credential) => ({
    credential,
    full: await getImage({
      src: credential.image,
      width: Math.min(1500, credential.image.width),
      format: 'webp',
    }),
  })),
);
// Hung by eye: widths and tilts repeat on a short cycle so the wall does not look like a grid.
const widths = [330, 270, 300, 250, 290, 320, 260];
const tilts = [-1.6, 1.1, -0.5, 1.8, -1.2, 0.7, -2];
---

<section id="certificates" class="cat-sec cat-certs cat-dark" data-thread="left">
  <div class="cat-wrap">
    <p class="cat-note" data-cat-reveal>
      Certificates
    </p>
    <h2 class="cat-h2" data-cat-reveal>
      Courses I <em>saw through</em>
    </h2>
    <p class="cat-certs-hint">Pick a frame to take it down for a closer look.</p>
    <ul class="cat-wall">
      {items.map(({ credential, full }, index) => (
        <li
          class:list={['cat-cert', credential.kind === 'badge' && 'is-badge']}
          data-cat-reveal
          style={`--i:${index % 4};--cert-w:${widths[index % widths.length] ?? 280}px;--tilt:${tilts[index % tilts.length] ?? 0}deg;--tilt-from:${(tilts[index % tilts.length] ?? 0) * 5}deg`}
        >
          <a
            class="cat-cert-link"
            href={full.src}
            data-cat-cert
            data-title={credential.title}
            data-issuer={credential.issuer}
            data-alt={credentialAlt(credential)}
          >
            <span class="cat-cert-frame" data-cat-knock>
              <Image
                src={credential.image}
                alt={credentialAlt(credential)}
                width={credential.kind === 'badge' ? 240 : 440}
                loading="lazy"
              />
            </span>
            <span class="cat-cert-plate">
              <strong>{credential.title}</strong>
              <span>{credential.issuer}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="cat-lightbox" data-cat-lightbox aria-labelledby="cat-lightbox-title">
    <div class="cat-lightbox-frame" data-cat-lightbox-perch>
      <img data-cat-lightbox-img src="" alt="" />
    </div>
    <p class="cat-lightbox-caption">
      <strong id="cat-lightbox-title" data-cat-lightbox-title></strong>
      <span data-cat-lightbox-issuer></span>
    </p>
    <div class="cat-lightbox-controls">
      <button type="button" data-cat-lightbox-prev>
        Previous
      </button>
      <button type="button" data-cat-lightbox-close>
        Hang it back up
      </button>
      <button type="button" data-cat-lightbox-next>
        Next
      </button>
    </div>
  </dialog>
</section>

<style is:global>
  .lab-cat .cat-certs {
    position: relative;
    background: linear-gradient(#4a3350, var(--plum) 320px, #33233a);
  }
  .lab-cat .cat-certs-hint {
    margin-top: 18px;
    font: 500 25px/1.1 var(--hand);
    color: #e9c9b4;
  }
  .lab-cat .cat-wall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 64px clamp(26px, 4vw, 56px);
    margin-top: 80px;
  }
  .lab-cat .cat-cert {
    width: var(--cert-w);
    rotate: var(--tilt);
  }
  .lab-cat .cat-cert.is-badge {
    width: 190px;
  }
  .lab-cat .cat-cert-link {
    position: relative;
    display: block;
    text-decoration: none;
  }
  /* Nail and wire */
  .lab-cat .cat-cert-link::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% - 2px);
    width: 38%;
    height: 22px;
    translate: -50% 0;
    background:
      radial-gradient(circle at 50% 3px, #e9c9b4 0 3px, transparent 3.5px),
      linear-gradient(
          to top right,
          transparent calc(50% - 0.8px),
          #a58a9a 50%,
          transparent calc(50% + 0.8px)
        )
        left / 50% 100% no-repeat,
      linear-gradient(
          to top left,
          transparent calc(50% - 0.8px),
          #a58a9a 50%,
          transparent calc(50% + 0.8px)
        )
        right / 50% 100% no-repeat;
  }
  .lab-cat .cat-cert-frame {
    display: block;
    border: 15px solid transparent;
    border-image: url('/lab/cat/frame.webp') 43 / 15px stretch;
    background: var(--paper) padding-box;
    box-shadow: 0 14px 22px -8px rgb(20 10 24 / 55%);
    transform-origin: 50% -18px;
    transition:
      rotate 0.5s cubic-bezier(0.3, 1.8, 0.5, 1),
      scale 0.3s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .lab-cat .cat-cert-link:hover .cat-cert-frame {
    rotate: 1.5deg;
    scale: 1.03;
  }
  .lab-cat .cat-cert-frame img {
    display: block;
    width: 100%;
  }
  .lab-cat .cat-cert-plate {
    display: block;
    margin-top: 12px;
    text-align: center;
  }
  .lab-cat .cat-cert-plate strong {
    display: block;
    font: 500 18px/1.2 var(--serif);
    text-wrap: balance;
  }
  .lab-cat .cat-cert-plate span {
    display: block;
    margin-top: 3px;
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cdb3bf;
  }

  .lab-cat .cat-lightbox {
    max-width: min(94vw, 1000px);
    max-height: 100vh;
    padding: 124px 14px 16px;
    border: 0;
    background: none;
    color: var(--cream);
    overflow: visible;
    text-align: center;
  }
  .lab-cat .cat-lightbox::backdrop {
    background: rgb(30 19 34 / 88%);
  }
  .lab-cat .cat-lightbox-frame {
    position: relative;
    display: inline-block;
    border: clamp(14px, 3vw, 30px) solid transparent;
    border-image: url('/lab/cat/frame.webp') 43 / clamp(14px, 3vw, 30px) stretch;
    background: var(--paper) padding-box;
    --perch-x: 12%;
    --perch-w: clamp(76px, 11vw, 108px);
  }
  .lab-cat .cat-lightbox-frame .cat-napper {
    bottom: calc(100% + clamp(8px, 2vw, 22px));
  }
  .lab-cat .cat-lightbox-frame > img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(84vw, 900px);
    max-height: calc(100vh - 370px);
    min-height: 120px;
  }
  .lab-cat .cat-lightbox-caption {
    margin-top: 14px;
  }
  .lab-cat .cat-lightbox-caption strong {
    display: block;
    font: 500 clamp(20px, 2.6vw, 28px) / 1.15 var(--serif);
  }
  .lab-cat .cat-lightbox-caption span {
    font: 600 12.5px/1.4 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #cdb3bf;
  }
  .lab-cat .cat-lightbox-controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
  }
  .lab-cat .cat-lightbox-controls button {
    padding: 11px 16px;
    border: 2px solid var(--cream);
    border-radius: 255px 18px 225px 18px / 18px 225px 18px 255px;
    background: none;
    color: var(--cream);
    font: 700 14px/1 var(--sans);
    cursor: pointer;
  }
  .lab-cat .cat-lightbox-controls button:hover {
    background: var(--cream);
    color: var(--plum);
  }

  @media (max-width: 759px) {
    .lab-cat .cat-wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 46px 18px;
      margin-top: 60px;
    }
    .lab-cat .cat-cert,
    .lab-cat .cat-cert.is-badge {
      width: auto;
    }
    .lab-cat .cat-cert.is-badge .cat-cert-frame {
      margin: 0 14%;
    }
    .lab-cat .cat-cert-frame {
      border-width: 10px;
      border-image-width: 10px;
    }
    .lab-cat .cat-cert-plate strong {
      font-size: 15.5px;
    }
    .lab-cat .cat-cert-plate span {
      font-size: 10.5px;
    }
  }
</style>
