---
// Work: three picture books. Each cover has its write-up tucked underneath, and the page slides
// out as the book scrolls up the screen (reveals.ts sets --q from 0 closed to 1 open).
import { workRows } from '../../../data/work';
import { getProjects } from '../../../lib/collections';
import { projectHref } from '../../../lib/content';
import Art from './Art.astro';
import type { ArtName } from './art';

const projects = await getProjects();
const covers: ArtName[] = ['book-a', 'book-b', 'book-c'];
const books = workRows.map((row, index) => ({
  row,
  cover: covers[index % covers.length] ?? 'book-a',
  description: projects.find((project) => project.id === row.id)?.data.description,
}));
---

<section id="work" class="cat-sec cat-work" data-thread="left">
  <div class="cat-wrap">
    <p class="cat-note" data-cat-reveal>
      Work
    </p>
    <h2 class="cat-h2" data-cat-reveal>
      Projects I have <em>written up</em>
    </h2>
    <ul class="cat-books">
      {books.map(({ row, cover, description }) => (
        <li class="cat-book" data-cat-book>
          <div class="cat-book-cover" aria-hidden="true">
            <Art name={cover} />
          </div>
          <div class="cat-book-page" data-cat-perch>
            <p class="cat-book-label">{row.label}</p>
            <h3>
              <a href={projectHref(row.id)}>{row.title}</a>
            </h3>
            {description && <p class="cat-book-text">{description}</p>}
            <p class="cat-book-more" aria-hidden="true">
              Read the write-up <span>&rarr;</span>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <div class="cat-blog">
      <div class="cat-box" aria-hidden="true">
        <Art name="box" />
        <span class="cat-peek cat-box-cat" data-cat-peek data-pose="peek">
          <Art name="grey-peek" data-pose="peek" />
          <Art name="grey-peek-blink" data-pose="blink" />
        </span>
      </div>
      <div>
        <p class="cat-blog-text">The rest of my notes and articles are in the box.</p>
        <a class="cat-link" href="/blog/">
          Open the blog
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .lab-cat .cat-work {
    position: relative;
    background: linear-gradient(#f1d9c0, #e6bfae 55%, #d8a79f);
  }
  .lab-cat .cat-books {
    display: grid;
    gap: clamp(70px, 9vw, 120px);
    margin-top: 90px;
  }
  .lab-cat .cat-book {
    --q: 1;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 560px);
    align-items: center;
    justify-content: start;
  }
  .lab-cat .cat-book:nth-child(even) {
    margin-left: auto;
  }
  .lab-cat .cat-book-cover {
    position: relative;
    z-index: 2;
    rotate: calc(-2deg - (1 - var(--q)) * 7deg);
    translate: calc((1 - var(--q)) * -40px) 0;
    filter: drop-shadow(6px 9px 0 rgb(59 42 63 / 20%));
    transition: scale 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .lab-cat .cat-book:nth-child(even) .cat-book-cover {
    rotate: calc(2.5deg + (1 - var(--q)) * 6deg);
  }
  .lab-cat .cat-book:hover .cat-book-cover {
    scale: 1.035;
  }
  .lab-cat .cat-book-cover img {
    display: block;
    width: 100%;
  }
  .lab-cat .cat-book-page {
    position: relative;
    z-index: 1;
    margin-left: -34px;
    padding: 34px 36px 34px 64px;
    background:
      repeating-linear-gradient(transparent 0 33px, rgb(59 42 63 / 9%) 33px 34px), var(--paper);
    border: 2px solid var(--plum);
    border-radius: 4px 16px 18px 4px;
    box-shadow: 5px 6px 0 rgb(59 42 63 / 16%);
    rotate: 0.8deg;
    /* Tucked under the cover until the book opens. */
    translate: calc((1 - var(--q)) * -62%) 0;
    opacity: calc(0.25 + var(--q) * 0.75);
  }
  .lab-cat .cat-book-label {
    font: 700 12px/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--marm-ink);
  }
  .lab-cat .cat-book-page h3 {
    margin-top: 10px;
    font: 500 clamp(27px, 3vw, 38px) / 1.08 var(--serif);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lab-cat .cat-book-page h3 a {
    text-decoration: none;
  }
  /* The whole book is the link. */
  .lab-cat .cat-book-page h3 a::after {
    content: '';
    position: absolute;
    inset: -40px -10px -40px -300px;
    z-index: 3;
  }
  .lab-cat .cat-book-text {
    margin-top: 14px;
    font-size: 16.5px;
  }
  .lab-cat .cat-book-more {
    margin-top: 16px;
    font: 700 26px/1 var(--hand);
    color: var(--marm-ink);
  }
  .lab-cat .cat-book-more span {
    display: inline-block;
    transition: translate 0.25s;
  }
  .lab-cat .cat-book:hover .cat-book-more span {
    translate: 8px 0;
  }

  .lab-cat .cat-blog {
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 48px);
    margin-top: 120px;
  }
  .lab-cat .cat-box {
    position: relative;
    flex: none;
    width: clamp(150px, 20vw, 230px);
  }
  .lab-cat .cat-box > img {
    position: relative;
    display: block;
    width: 100%;
  }
  /* The cat's bottom edge is cut off at the front rim of the box. */
  .lab-cat .cat-peek.cat-box-cat {
    left: 27%;
    bottom: 54%;
    z-index: 1;
    width: 46%;
  }
  .lab-cat .cat-blog-text {
    max-width: 22ch;
    margin-bottom: 18px;
    font: 500 clamp(24px, 3vw, 32px) / 1.15 var(--serif);
  }

  @media (max-width: 759px) {
    .lab-cat .cat-book {
      grid-template-columns: 1fr;
    }
    .lab-cat .cat-book-cover {
      width: 58%;
      translate: 0 calc((1 - var(--q)) * 30px);
    }
    .lab-cat .cat-book:nth-child(even) .cat-book-cover {
      margin-left: auto;
    }
    .lab-cat .cat-book-page {
      margin: -30px 0 0;
      padding: 50px 22px 26px;
      translate: 0 calc((1 - var(--q)) * -40%);
    }
    .lab-cat .cat-book-page h3 a::after {
      inset: -260px 0 0;
    }
    .lab-cat .cat-blog {
      margin-top: 90px;
    }
  }
</style>
