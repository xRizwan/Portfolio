---
// Experience: a hallway at dusk. With scripts and motion on, the section pins and vertical
// scrolling walks the reader (and the ginger cat) sideways past one framed role after another,
// each lighting up as it is passed (hallway.ts). Otherwise the frames are a plain column.
import { experienceIntro, roles } from '../../../data/experience';
import Art from './Art.astro';

// A wavy line for the yarn lying along the floor (drawn with a non-scaling stroke).
const floorThread =
  'M0 5' +
  Array.from(
    { length: 40 },
    (_, i) => `Q${i * 25 + 12.5} ${i % 2 ? 7.5 : 2.5} ${i * 25 + 25} 5`,
  ).join('');
---

<section
  id="experience"
  class="cat-hall cat-dark"
  data-cat-hall
  data-cat-nofollow
  data-thread="right"
>
  <div class="cat-hall-stage" data-cat-hall-stage>
    <img
      class="cat-hall-room"
      src="/lab/cat/room.webp"
      width="1600"
      height="900"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="cat-hall-dusk" aria-hidden="true"></span>
    <div class="cat-hall-track" data-cat-hall-track>
      <header class="cat-hall-intro">
        <p class="cat-note">{experienceIntro.eyebrow}</p>
        <h2 class="cat-h2">
          {experienceIntro.headline[0]}
          <em>{experienceIntro.headline[1]}</em>
        </h2>
        <p class="cat-hall-hint">Keep scrolling to walk down the hallway.</p>
      </header>
      {roles.map((role) => (
        <article class="cat-role" data-cat-role>
          <span class="cat-role-glow" aria-hidden="true" />
          <Art name="sconce" class="cat-role-lamp" />
          <div class="cat-role-frame" data-cat-knock>
            <p class="cat-role-dates">{role.dates}</p>
            <h3>{role.company}</h3>
            <p class="cat-role-kind">{role.kind}</p>
            <ul class="cat-role-titles">
              {role.titles.map((title) => (
                <li>
                  <strong>{title.title}</strong>
                  {role.titles.length > 1 && <span>{title.dates}</span>}
                </li>
              ))}
            </ul>
            <p class="cat-role-summary">{role.summary}</p>
            <details class="cat-role-more">
              <summary>What I did there</summary>
              <ul>
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </details>
          </div>
        </article>
      ))}
      <div class="cat-hall-end">
        <Art name="door" class="cat-hall-door" />
        <a class="cat-link" href="/experience/">
          Read the full story
        </a>
      </div>
    </div>
    <div class="cat-hall-floor" data-cat-hall-floor aria-hidden="true">
      <svg class="cat-hall-yarn" viewBox="0 0 1000 10" preserveAspectRatio="none">
        <path d={floorThread}></path>
      </svg>
      <div class="cat-hall-walker" data-cat-hall-walker data-pose="sit">
        <Art name="ginger-walk-a" data-pose="walk-a" style="--w:440" />
        <Art name="ginger-walk-b" data-pose="walk-b" style="--w:475" />
        <Art name="ginger-sit" data-pose="sit" style="--w:310" />
      </div>
      <img
        class="cat-hall-ball"
        data-cat-hall-ball
        src="/lab/cat/yarn-ball.webp"
        width="240"
        height="240"
        alt=""
        loading="lazy"
      />
    </div>
  </div>
</section>

<style is:global>
  .lab-cat .cat-hall {
    position: relative;
    background: linear-gradient(#d8a79f, #6b4a62 190px, #4a3350);
  }
  .lab-cat .cat-hall-stage {
    position: relative;
    z-index: 2;
    padding: 190px var(--pad) 120px;
  }
  .lab-cat .cat-hall-room,
  .lab-cat .cat-hall-dusk,
  .lab-cat .cat-hall-floor {
    display: none;
  }
  .lab-cat .cat-hall-track {
    display: flex;
    flex-direction: column;
    gap: 110px;
    max-width: 620px;
    margin: 0 auto;
  }
  .lab-cat .cat-hall-hint {
    display: none;
    margin-top: 22px;
    font: 500 25px/1.1 var(--hand);
    color: #f3c9a0;
  }

  .lab-cat .cat-role {
    --lit: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lab-cat .cat-role-glow {
    position: absolute;
    left: 50%;
    top: -16%;
    width: 160%;
    height: 120%;
    translate: -50% 0;
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      rgb(255 205 130 / 46%),
      rgb(255 205 130 / 12%) 55%,
      rgb(255 205 130 / 0%) 100%
    );
    opacity: var(--lit);
    pointer-events: none;
  }
  .lab-cat .cat-role-lamp {
    position: relative;
    width: 64px;
    margin-bottom: -4px;
    filter: brightness(calc(0.55 + var(--lit) * 0.5));
  }
  .lab-cat .cat-role-frame {
    position: relative;
    width: 100%;
    padding: 20px 24px 18px;
    border: 26px solid transparent;
    border-image: url('/lab/cat/frame.webp') 43 / 26px stretch;
    background: var(--paper) padding-box;
    color: var(--plum);
    filter: brightness(calc(0.5 + var(--lit) * 0.5));
    transition: rotate 0.5s cubic-bezier(0.3, 1.8, 0.5, 1);
    transform-origin: 50% 0;
  }
  .lab-cat .cat-role-dates {
    font: 700 25px/1 var(--hand);
    color: var(--marm-ink);
  }
  .lab-cat .cat-role-frame h3 {
    margin-top: 2px;
    font: 600 clamp(38px, 4.4vw, 54px) / 1 var(--serif);
    letter-spacing: -0.025em;
  }
  .lab-cat .cat-role-kind {
    margin-top: 8px;
    font: 700 11.5px/1.35 var(--sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--plum-soft);
  }
  .lab-cat .cat-role-titles {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 2px dotted rgb(59 42 63 / 35%);
  }
  .lab-cat .cat-role-titles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 14px;
    font-size: 15px;
  }
  .lab-cat .cat-role-titles strong {
    font: 500 italic 19px/1.3 var(--serif);
  }
  .lab-cat .cat-role-titles span {
    color: var(--plum-soft);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.9;
  }
  .lab-cat .cat-role-summary {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
  }
  .lab-cat .cat-role-more {
    margin-top: 12px;
  }
  .lab-cat .cat-role-more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 2px solid var(--plum);
    border-radius: 255px 18px 225px 18px / 18px 225px 18px 255px;
    font: 700 13.5px/1 var(--sans);
    cursor: pointer;
    list-style: none;
  }
  .lab-cat .cat-role-more summary::-webkit-details-marker {
    display: none;
  }
  .lab-cat .cat-role-more summary::after {
    content: '+';
    font-size: 17px;
  }
  .lab-cat .cat-role-more[open] summary::after {
    content: '\2212';
  }
  .lab-cat .cat-role-more[open] summary {
    background: var(--plum);
    color: var(--cream);
  }
  .lab-cat .cat-role-more ul {
    margin-top: 12px;
    padding-left: 18px;
    list-style: disc;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .lab-cat .cat-role-more li + li {
    margin-top: 7px;
  }
  .lab-cat .cat-role-more li::marker {
    color: var(--marm);
  }

  .lab-cat .cat-hall-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .lab-cat .cat-hall-door {
    display: none;
  }

  /* Pinned hallway: scripts and motion on. */
  .lab-cat .cat-hall.is-pinned {
    background: #4a3350;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding: 0;
    overflow: hidden;
    background: #6b4a62;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-room {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 100%;
  }
  /* Evening: the same wall as the opening, with the light gone out of it. */
  .lab-cat .cat-hall.is-pinned .cat-hall-dusk {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(#77567a, #5d4162);
    mix-blend-mode: multiply;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 17%;
    flex-direction: row;
    align-items: flex-start;
    gap: clamp(90px, 13vw, 210px);
    max-width: none;
    margin: 0;
    padding: clamp(80px, 11vh, 120px) 12vw 0 max(var(--pad), 9vw);
    will-change: transform;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-intro {
    flex: none;
    width: min(78vw, 520px);
    padding-top: 7vh;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-hint {
    display: block;
  }
  .lab-cat .cat-hall.is-pinned .cat-role {
    flex: none;
    width: min(84vw, 470px);
  }
  .lab-cat .cat-hall.is-pinned .cat-role-lamp {
    width: clamp(40px, 6.5vh, 60px);
  }
  /* The frames have to hang clear of the skirting board, so tighten them on short screens. */
  @media (max-height: 820px), (max-width: 759px) {
    .lab-cat .cat-hall.is-pinned .cat-role-frame {
      padding: 12px 20px 14px;
      border-width: 21px;
      border-image-width: 21px;
    }
    .lab-cat .cat-hall.is-pinned .cat-role-frame h3 {
      font-size: clamp(34px, 3.6vw, 44px);
    }
    .lab-cat .cat-hall.is-pinned .cat-role-titles {
      margin-top: 9px;
      padding-top: 8px;
    }
    .lab-cat .cat-hall.is-pinned .cat-role-summary {
      margin-top: 8px;
      font-size: 14.5px;
      line-height: 1.45;
    }
    .lab-cat .cat-hall.is-pinned .cat-role-more {
      margin-top: 9px;
    }
  }
  /* The list of points opens over the framed card instead of pushing the hallway about. */
  .lab-cat .cat-hall.is-pinned .cat-role-more ul {
    position: absolute;
    inset: 0 0 52px;
    margin: 0;
    padding: 16px 16px 16px 32px;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--paper);
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-end {
    flex: none;
    position: relative;
    align-self: flex-end;
    gap: 0;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-door {
    display: block;
    width: auto;
    height: min(56vh, 520px, 130vw);
    max-width: none;
    filter: brightness(0.8);
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-end .cat-link {
    position: absolute;
    top: -70px;
    background: var(--paper);
    border-color: var(--plum);
    color: var(--plum);
    white-space: nowrap;
    rotate: -2deg;
  }
  .lab-cat .cat-hall.is-pinned .cat-hall-end .cat-link:hover {
    background: var(--marm);
  }

  .lab-cat .cat-hall.is-pinned .cat-hall-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8.5%;
    display: block;
    height: 0;
    --walker-x: max(7vw, 34px);
    --walker-w: clamp(92px, 19vh, 150px);
  }
  .lab-cat .cat-hall-yarn {
    position: absolute;
    left: 0;
    bottom: -4px;
    width: calc(var(--walker-x) + var(--walker-w) * 1.52);
    height: 10px;
    overflow: visible;
  }
  .lab-cat .cat-hall-yarn path {
    fill: none;
    stroke: var(--marm);
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .lab-cat .cat-hall-walker {
    position: absolute;
    left: var(--walker-x);
    bottom: 0;
    width: var(--walker-w);
    aspect-ratio: 440 / 335;
  }
  .lab-cat .cat-hall-walker img {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: calc(var(--w) / 440 * 100%);
    max-width: none;
    translate: -50% 0;
    opacity: 0;
  }
  .lab-cat .cat-hall-walker[data-pose='walk-a'] img[data-pose='walk-a'],
  .lab-cat .cat-hall-walker[data-pose='walk-b'] img[data-pose='walk-b'],
  .lab-cat .cat-hall-walker[data-pose='sit'] img[data-pose='sit'] {
    opacity: 1;
  }
  .lab-cat .cat-hall-ball {
    position: absolute;
    left: calc(var(--walker-x) + var(--walker-w) * 1.3);
    bottom: -2px;
    width: calc(var(--walker-w) * 0.36);
    height: auto;
  }
</style>
