---
// Skills: the luggage rack. Each case, trunk or hat box is one group; opening it lets its
// luggage labels drop down on their strings (cases.ts). Without scripts every case is open.
import { skillGroups } from '../../../data/skills';
import TrCar from './TrCar.astro';
import { art } from './art';

const luggage = [art.suitcase, art.trunk, art.hatbox];
---

<TrCar id="skills">
  <header class="tr-plate tr-sway">
    <p class="tr-kicker">Luggage van</p>
    <h2 class="tr-h2" id="tr-skills-title">
      What I <em>carry</em>
    </h2>
    <p class="tr-hint">Each case is one kind of work. Open a case and its labels drop down.</p>
  </header>

  <div class="tr-rack">
    <span class="tr-rack-rail" aria-hidden="true"></span>
    {skillGroups.map((group, index) => {
      const piece = luggage[index % luggage.length] ?? art.suitcase;
      return (
        <article class="tr-case is-open" data-tr-auto>
          <h3 class="tr-case-head">
            <button
              type="button"
              class="tr-case-button"
              aria-expanded="true"
              aria-controls={`tr-tags-${group.id}`}
              data-tr-toggle
            >
              <img
                src={piece.src}
                width={piece.width}
                height={piece.height}
                loading="lazy"
                alt=""
              />
              <span class="tr-case-label">{group.title}</span>
            </button>
          </h3>
          <ul class="tr-tags" id={`tr-tags-${group.id}`} aria-label={group.name}>
            {group.items.map((item, itemIndex) => (
              <li style={`--i:${itemIndex}`}>
                <span class="tr-tag">{item}</span>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>
</TrCar>

<style is:global>
  .lab-train .tr-rack {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 44px 38px;
    --tr-case-h: clamp(96px, 15vh, 128px);
    --tr-rows: 6;
    --tr-tag-w: 158px;
  }
  html.tr-pin .lab-train .tr-rack {
    flex-wrap: nowrap;
    align-self: stretch;
    gap: clamp(34px, 4vw, 64px);
  }
  /* The brass rail and netting the luggage sits on. */
  .lab-train .tr-rack-rail {
    display: none;
  }
  html.tr-pin .lab-train .tr-rack-rail {
    position: absolute;
    top: calc(var(--tr-case-h) - 3px);
    left: -60px;
    right: -60px;
    display: block;
    height: 20px;
    background:
      linear-gradient(180deg, var(--tr-brass) 0 4px, #0000 4px 16px, #6b4a22 16px 19px, #0000 19px),
      repeating-linear-gradient(60deg, #0000 0 7px, rgb(201 154 78 / 55%) 7px 8.5px),
      repeating-linear-gradient(-60deg, #0000 0 7px, rgb(201 154 78 / 55%) 7px 8.5px);
  }
  .lab-train .tr-case {
    flex: none;
    min-width: 190px;
  }
  .lab-train .tr-case-head {
    display: flex;
    align-items: flex-end;
    height: var(--tr-case-h);
  }
  .lab-train .tr-case-button {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: 50% 100%;
    transition: transform 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .lab-train .tr-case-button img {
    width: auto;
    height: calc(var(--tr-case-h) - 8px);
  }
  .lab-train .tr-case.is-open .tr-case-button {
    transform: rotate(-2.5deg) translateY(-3px);
  }
  .lab-train .tr-case-button:hover {
    transform: rotate(2deg) translateY(-5px);
  }
  /* The destination label pasted on the front. */
  .lab-train .tr-case-label {
    position: absolute;
    left: 50%;
    top: 58%;
    width: max-content;
    max-width: 92%;
    padding: 4px 9px 5px;
    border: 1.5px solid var(--tr-ink);
    border-radius: 2px;
    background: var(--tr-cream);
    color: var(--tr-ink);
    font: 600 clamp(13px, 1.1vw, 15.5px) / 1.1 var(--tr-serif);
    text-align: center;
    text-wrap: balance;
    transform: translate(-50%, -50%) rotate(-3deg);
  }

  .lab-train .tr-tags {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--tr-tag-w));
    gap: 14px 12px;
    margin-top: 30px;
    max-width: calc(var(--tr-tag-w) * 4 + 36px);
  }
  html.tr-pin .lab-train .tr-tags {
    grid-template-columns: none;
    grid-template-rows: repeat(var(--tr-rows), auto);
    grid-auto-flow: column;
    grid-auto-columns: var(--tr-tag-w);
    max-width: none;
  }
  .lab-train .tr-tags li {
    position: relative;
    transition:
      transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1),
      opacity 0.25s ease;
    transition-delay: calc(var(--i) * 26ms);
  }
  /* The string each label hangs from. */
  .lab-train .tr-tags li::before {
    content: '';
    position: absolute;
    bottom: calc(100% - 9px);
    left: 15px;
    width: 1.5px;
    height: 24px;
    background: rgb(246 231 200 / 70%);
  }
  .lab-train .tr-tag {
    position: relative;
    display: flex;
    align-items: center;
    height: 42px;
    padding: 0 9px 0 30px;
    border-radius: 3px;
    background: var(--tr-grain-dark), var(--tr-cream);
    color: var(--tr-ink);
    font: 700 12.5px/1.15 var(--tr-sans);
    /* Clipped corners and a punched hole make it a luggage label. */
    clip-path: polygon(11px 0, 100% 0, 100% 100%, 11px 100%, 0 calc(100% - 11px), 0 11px);
    transform-origin: 15px 0;
    animation: tr-sway calc(2.6s + var(--i) * 0.17s) ease-in-out calc(var(--i) * -0.4s) infinite
      alternate;
    --tr-reach: 1.6deg;
  }
  .lab-train .tr-tag::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border: 2px solid #b8822f;
    border-radius: 50%;
    background: var(--tr-wood-dark);
  }
  .lab-train .tr-tags li:nth-child(3n + 2) .tr-tag {
    background: var(--tr-grain-dark), #f0c683;
  }
  .lab-train .tr-tags li:nth-child(5n + 4) .tr-tag {
    background: var(--tr-grain-dark), #c9d8e6;
  }
  .lab-train .tr-case:not(.is-open) .tr-tags {
    visibility: hidden;
    transition: visibility 0s 0.45s;
  }
  .lab-train .tr-case:not(.is-open) .tr-tags li {
    opacity: 0;
    transform: translateY(-46px) rotate(-7deg) scale(0.8);
    transition-delay: 0s;
  }

  @media (max-width: 700px) {
    .lab-train .tr-rack {
      --tr-case-h: 92px;
      --tr-rows: 7;
      --tr-tag-w: 146px;
    }
    .lab-train .tr-tags {
      gap: 13px 10px;
      margin-top: 26px;
    }
    .lab-train .tr-tag {
      height: 38px;
      font-size: 12px;
    }
  }
  @media (max-height: 700px) and (min-width: 701px) {
    .lab-train .tr-rack {
      --tr-rows: 5;
    }
  }
</style>
