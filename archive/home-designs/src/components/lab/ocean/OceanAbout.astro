---
// The cave: a shaded pocket of the reef. The rock arch drifts as the page scrolls and the three
// traits each have a creature sitting on their card.
import { experienceIntro } from '../../../data/experience';
import { art, type ArtName } from './art';
import { cutPanel, edgeMask } from './paper';

const { about } = experienceIntro;
// One creature per trait, in the order of the data.
const residents: ArtName[] = ['seahorse', 'puffer', 'crab'];
const shadeTop = edgeMask({ seed: 21, height: 70, swell: 14, jitter: 5 });
const shadeBottom = edgeMask({ seed: 22, height: 70, swell: 14, jitter: 5 }, true);
---

<section class="oc-section oc-about" id="about" data-tone="teal" aria-labelledby="oc-about-title">
  <div
    class="oc-shade"
    style={{ '--top': shadeTop, '--bottom': shadeBottom }}
    aria-hidden="true"
  ></div>
  <div class="oc-clip" aria-hidden="true">
    <img
      class="oc-art oc-about-arch"
      {...art('arch')}
      alt=""
      loading="lazy"
      data-drift="-70"
      data-drift-x="50"
    />
    <img class="oc-art oc-about-weed oc-sway" {...art('seaweed')} alt="" loading="lazy" />
  </div>
  <div class="oc-wrap">
    <p class="oc-place">The cave</p>
    <h2 class="oc-h2" id="oc-about-title">
      About me
    </h2>
    <div class="oc-about-text">
      <p class="oc-about-lead" data-rise>
        {about.lead}
      </p>
      <div class="oc-paper oc-about-body" style={{ '--cut': cutPanel(31) }} data-rise>
        <p>{about.body}</p>
      </div>
    </div>
    <ul class="oc-traits">
      {about.traits.map((trait, index) => (
        <li
          class="oc-paper oc-trait"
          style={{
            '--cut': cutPanel(40 + index),
            '--rise-i': index,
            '--rise-tilt': `${index % 2 === 0 ? -3 : 3}deg`,
          }}
          data-rise
        >
          <img
            class="oc-trait-pet oc-bob"
            {...art(residents[index % residents.length] ?? 'seahorse')}
            alt=""
            loading="lazy"
            style={{ animationDelay: `${index * -1.3}s` }}
          />
          <h3>{trait.title}</h3>
          <p>{trait.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  /* A band of deeper water with scissor-cut top and bottom edges. */
  .lab-ocean .oc-shade {
    position: absolute;
    inset: 0;
    background: rgb(15 78 110 / 46%);
    mask:
      var(--top) 0 0 / 100% 70px no-repeat,
      var(--bottom) 0 100% / 100% 70px no-repeat,
      linear-gradient(#000, #000) 0 69px / 100% calc(100% - 138px) no-repeat;
  }
  .lab-ocean .oc-about-arch {
    right: -7vw;
    top: 6%;
    width: min(62vw, 880px);
  }
  .lab-ocean .oc-about-weed {
    left: 3vw;
    bottom: -10px;
    width: clamp(70px, 8vw, 130px);
  }
  .lab-ocean .oc-about .oc-h2 {
    color: var(--oc-foam);
  }
  .lab-ocean .oc-about-text {
    display: grid;
    gap: 26px;
    max-width: 620px;
    margin-top: 34px;
  }
  .lab-ocean .oc-about-lead {
    color: var(--oc-foam);
    font: 600 clamp(26px, 3vw, 40px) / 1.12 var(--oc-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lab-ocean .oc-about-body {
    padding: clamp(22px, 3vw, 34px);
    font-size: clamp(16px, 1.3vw, 18px);
  }
  .lab-ocean .oc-traits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    margin-top: clamp(70px, 9vw, 110px);
  }
  .lab-ocean .oc-trait {
    padding: 44px 24px 26px;
    --oc-paper-tint: var(--oc-foam);
  }
  .lab-ocean .oc-trait:nth-child(2) {
    margin-top: 34px;
    --oc-paper-tint: #ffd98a;
  }
  .lab-ocean .oc-trait:nth-child(3) {
    margin-top: 8px;
    --oc-paper-tint: #ffb3a8;
  }
  .lab-ocean .oc-trait-pet {
    position: absolute;
    right: 10px;
    top: -58px;
    width: auto;
    height: 104px;
  }
  .lab-ocean .oc-trait h3 {
    font: 800 clamp(22px, 2vw, 27px) / 1.05 var(--oc-display);
    letter-spacing: -0.02em;
  }
  .lab-ocean .oc-trait p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.5;
  }
  @media (max-width: 860px) {
    .lab-ocean .oc-about-arch {
      top: 1%;
      right: -30vw;
      width: 120vw;
      opacity: 0.55;
    }
    .lab-ocean .oc-traits {
      grid-template-columns: 1fr;
      gap: 62px;
    }
    .lab-ocean .oc-trait:nth-child(n) {
      margin-top: 0;
    }
  }
</style>
