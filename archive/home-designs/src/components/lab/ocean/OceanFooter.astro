---
// The sea floor closes the page.
import { site } from '../../../data/site';
import { art } from './art';
import { edgeMask } from './paper';

const floorMask = edgeMask({ seed: 141, height: 110, swell: 12, jitter: 5 });
const year = new Date().getFullYear();
---

<footer class="oc-footer" data-tone="sand">
  <div class="oc-footer-sand" style={{ '--mask': floorMask }} aria-hidden="true">
    <div class="oc-floor"></div>
  </div>
  <img class="oc-art oc-footer-star" {...art('starfish')} alt="" loading="lazy" />
  <img class="oc-art oc-footer-helmet" {...art('helmet')} alt="" loading="lazy" />
  <div class="oc-wrap oc-footer-row">
    <p>
      © {year} {site.name}
    </p>
    <a href="#top">Back to the surface</a>
  </div>
</footer>

<style is:global>
  .lab-ocean .oc-footer {
    position: relative;
    z-index: 5;
    padding: 96px 0 96px;
  }
  .lab-ocean .oc-footer-sand {
    position: absolute;
    inset: 0;
    mask:
      var(--mask) 0 0 / 100% 110px no-repeat,
      linear-gradient(#000, #000) 0 109px / 100% 100% no-repeat;
  }
  .lab-ocean .oc-footer-sand .oc-floor {
    mask: none;
    overflow: hidden;
  }
  .lab-ocean .oc-footer-star {
    left: 8vw;
    top: 6px;
    width: clamp(52px, 6vw, 84px);
    rotate: 18deg;
  }
  .lab-ocean .oc-footer-helmet {
    right: 9vw;
    top: -34px;
    width: clamp(84px, 10vw, 140px);
  }
  .lab-ocean .oc-footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    font: 700 15px/1.3 var(--oc-body);
  }
  .lab-ocean .oc-footer-row a {
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 860px) {
    .lab-ocean .oc-footer {
      padding-bottom: 110px;
    }
  }
</style>
