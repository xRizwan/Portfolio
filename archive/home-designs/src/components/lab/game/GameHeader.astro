---
// Header: the name, anchor links to the places on the map, and the resume.
import { site } from '../../../data/site';
import { places } from './places';
---

<header class="qg-header" data-header>
  <a class="qg-header__name" href="#top" aria-label={`${site.shortName}, back to the top`}>
    <span class="qg-header__seal" aria-hidden="true"></span>
    {site.shortName}
  </a>
  <nav class="qg-header__nav" aria-label="Sections">
    {places.map((place) => (
      <a href={`#${place.id}`}>{place.holds}</a>
    ))}
  </nav>
  <a class="qg-header__resume" href={site.resume}>
    Resume
  </a>
</header>

<style is:global>
  .lab-game .qg-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 130;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 60px;
    padding: 0 clamp(14px, 2.4vw, 30px);
    color: var(--q-parch);
    font: 600 14px/1 var(--q-ui);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  /* Once the title screen is behind, the header becomes a strip of dark leather. */
  .lab-game .qg-header.is-solid {
    background: rgb(27 20 15 / 94%);
    box-shadow:
      0 2px 0 var(--q-gold),
      0 8px 22px rgb(0 0 0 / 25%);
  }
  html:not(.qg-js) .lab-game .qg-header {
    background: rgb(27 20 15 / 94%);
  }
  .lab-game .qg-header__name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 24px/1 var(--q-display);
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  /* A small wax seal, pressed slightly off-round. */
  .lab-game .qg-header__seal {
    width: 22px;
    height: 22px;
    border-radius: 46% 54% 50% 50% / 52% 47% 53% 48%;
    background: radial-gradient(
      circle at 38% 34%,
      #d6584d 0 18%,
      var(--q-crimson) 46%,
      #7f1f1a 100%
    );
    box-shadow:
      inset 0 0 0 3px rgb(127 31 26 / 55%),
      0 1px 0 rgb(0 0 0 / 40%);
  }
  .lab-game .qg-header__nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .lab-game .qg-header__nav a {
    padding: 9px 11px;
    border-radius: 6px;
    text-decoration: none;
    opacity: 0.86;
  }
  .lab-game .qg-header__nav a:hover,
  .lab-game .qg-header__nav a[aria-current='true'] {
    opacity: 1;
    color: var(--q-gold);
  }
  .lab-game .qg-header__nav a[aria-current='true'] {
    text-decoration: underline wavy var(--q-gold) 1.5px;
    text-underline-offset: 6px;
  }
  .lab-game .qg-header__resume {
    padding: 9px 14px;
    border: 1.5px solid var(--q-gold);
    border-radius: 3px 8px 4px 9px;
    color: var(--q-gold);
    text-decoration: none;
  }
  .lab-game .qg-header__resume:hover {
    background: var(--q-gold);
    color: var(--q-ink);
  }
  .lab-game .qg-header :where(a):focus-visible {
    outline-color: var(--q-gold);
  }
  @media (max-width: 820px) {
    /* On phones the links move to a strip that scrolls sideways under the name. */
    .lab-game .qg-header {
      flex-wrap: wrap;
      row-gap: 0;
      height: auto;
      padding-top: 8px;
    }
    .lab-game .qg-header__resume {
      margin-left: auto;
      padding: 8px 12px;
    }
    .lab-game .qg-header__nav {
      order: 3;
      width: 100%;
      margin: 2px 0 0;
      overflow-x: auto;
      scrollbar-width: none;
      /* A soft fade on the right says the strip scrolls. */
      mask-image: linear-gradient(90deg, #000 84%, transparent);
      -webkit-mask-image: linear-gradient(90deg, #000 84%, transparent);
    }
    .lab-game .qg-header__nav a {
      padding: 9px 8px 11px;
      font-size: 13px;
      white-space: nowrap;
    }
  }
</style>
