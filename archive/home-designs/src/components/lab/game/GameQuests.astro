---
// Work, as three notices on the quest board outside the dragon's cave. Each notice unfolds into
// the project's own description and a link to its page; a smaller note points at the blog.
import { workRows } from '../../../data/work';
import { getProjects } from '../../../lib/collections';
import { projectHref } from '../../../lib/content';
import { art } from './art';
import Flag from './Flag.astro';

const projects = await getProjects();
const statusLabels = {
  completed: 'Completed',
  ongoing: 'Ongoing',
  'design-study': 'Design study',
} as const;

const quests = workRows.map((row, index) => {
  const project = projects.find((entry) => entry.id === row.id);
  return {
    ...row,
    href: projectHref(row.id),
    description: project?.data.description,
    status: project ? statusLabels[project.data.status] : undefined,
    // A fixed lean per notice so the board looks pinned by hand.
    lean: [-2.2, 1.4, -1.1][index % 3] ?? 0,
  };
});
---

<section
  class="qg-place qg-quests"
  id="work"
  data-place="work"
  data-lane="gutter"
  aria-labelledby="qg-work-title"
>
  <div class="qg-inner">
    <header class="qg-head">
      <p class="qg-head__place">
        <Flag />
        Dragon’s cave
      </p>
      <h2 id="qg-work-title">
        Quest <em>board</em>
      </h2>
      <p class="qg-head__note">
        Three projects, pinned up as quests. Open a notice to see what it was about.
      </p>
    </header>

    <div class="qg-board">
      <ul class="qg-board__notes">
        {quests.map((quest, index) => (
          <li
            class="qg-notice"
            data-reveal
            style={{ '--lean': `${quest.lean}deg`, '--i': index, '--tilt-from': '4deg' }}
          >
            <img class="qg-notice__seal" {...art('item-seal')} alt="" loading="lazy" />
            <p class="qg-notice__label">{quest.label}</p>
            <h3>
              <a href={quest.href}>{quest.title}</a>
            </h3>
            <details class="qg-notice__more" data-notice>
              <summary>
                <span class="qg-notice__closed">Open the notice</span>
                <span class="qg-notice__open">Fold it back</span>
              </summary>
              <div class="qg-notice__body">
                {quest.description && <p>{quest.description}</p>}
                {quest.status && (
                  <p class="qg-notice__status">
                    <span>Status</span> {quest.status}
                  </p>
                )}
                <a class="qg-btn" href={quest.href}>
                  Read the write-up
                </a>
              </div>
            </details>
          </li>
        ))}
        <li
          class="qg-notice qg-notice--blog"
          data-reveal
          style={{ '--lean': '2.6deg', '--i': 3, '--tilt-from': '-4deg' }}
        >
          <p class="qg-notice__hand">More write-ups are in the blog.</p>
          <a class="qg-link" href="/blog/">
            Go to the blog
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style is:global>
  /* The board: painted planks, with the notices pinned on. */
  .lab-game .qg-board {
    position: relative;
    padding: clamp(26px, 4vw, 58px) clamp(16px, 3.4vw, 50px) clamp(30px, 4.4vw, 62px);
    border: 3px solid #3a2414;
    border-radius: 6px 12px 8px 14px;
    background:
      linear-gradient(rgb(60 34 16 / 22%), rgb(40 22 10 / 34%)),
      url('/lab/game/board.webp') center / cover;
    box-shadow:
      inset 0 0 60px rgb(30 16 6 / 50%),
      10px 14px 0 rgb(35 26 20 / 14%);
  }
  .lab-game .qg-board__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.6vw, 38px);
    align-items: start;
  }
  .lab-game .qg-notice {
    position: relative;
    padding: 44px clamp(18px, 2vw, 28px) 24px;
    border-radius: 2px 10px 3px 12px / 10px 3px 12px 2px;
    background-color: var(--q-parch-light);
    background-image: var(--q-grain), var(--q-stains);
    color: var(--q-ink);
    rotate: var(--lean);
    box-shadow:
      0 1px 0 rgb(35 26 20 / 50%),
      6px 10px 14px rgb(20 10 4 / 45%);
    transition:
      rotate 0.35s cubic-bezier(0.3, 1.4, 0.5, 1),
      translate 0.35s ease,
      box-shadow 0.35s ease;
  }
  .lab-game .qg-notice:nth-child(2) {
    margin-top: 34px;
  }
  .lab-game .qg-notice:nth-child(3) {
    margin-top: 10px;
  }
  /* A notice straightens and lifts when you reach for it or open it. */
  .lab-game .qg-notice:hover,
  .lab-game .qg-notice:focus-within,
  .lab-game .qg-notice:has(details[open]) {
    rotate: 0deg;
    translate: 0 -6px;
    box-shadow:
      0 1px 0 rgb(35 26 20 / 50%),
      10px 20px 24px rgb(20 10 4 / 50%);
  }
  .lab-game .qg-notice__seal {
    position: absolute;
    left: 50%;
    top: -20px;
    width: 54px;
    height: 54px;
    translate: -50% 0;
    filter: drop-shadow(0 4px 3px rgb(20 10 4 / 50%));
  }
  .lab-game .qg-notice__label {
    color: var(--q-crimson);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .lab-game .qg-notice h3 {
    margin-top: 8px;
    font: 600 clamp(25px, 2.5vw, 33px) / 1.08 var(--q-display);
    text-wrap: balance;
  }
  .lab-game .qg-notice h3 a {
    text-decoration: none;
  }
  .lab-game .qg-notice h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--q-crimson);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .lab-game .qg-notice__more {
    margin-top: 14px;
  }
  .lab-game .qg-notice__more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px;
    color: var(--q-teal);
    font: 700 24px/1 var(--q-hand);
    cursor: pointer;
    list-style: none;
  }
  .lab-game .qg-notice__more summary::-webkit-details-marker {
    display: none;
  }
  .lab-game .qg-notice__more summary::after {
    content: '';
    width: 9px;
    height: 9px;
    border-right: 2.5px solid currentcolor;
    border-bottom: 2.5px solid currentcolor;
    rotate: 45deg;
    translate: 0 -3px;
    transition: rotate 0.25s ease;
  }
  .lab-game .qg-notice__more[open] summary::after {
    rotate: 225deg;
    translate: 0 3px;
  }
  .lab-game .qg-notice__open,
  .lab-game .qg-notice__more[open] .qg-notice__closed {
    display: none;
  }
  .lab-game .qg-notice__more[open] .qg-notice__open {
    display: inline;
  }
  .lab-game .qg-notice__body {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1.5px dashed rgb(35 26 20 / 40%);
    font-size: 15.5px;
    line-height: 1.5;
  }
  html:not(.qg-still) .lab-game .qg-notice__more[open] .qg-notice__body {
    animation: qg-unfold 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-origin: top;
  }
  @keyframes qg-unfold {
    from {
      opacity: 0;
      transform: perspective(600px) rotateX(-38deg);
    }
  }
  .lab-game .qg-notice__status {
    font-weight: 700;
  }
  .lab-game .qg-notice__status span {
    margin-right: 6px;
    color: var(--q-ink-soft);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  /* The small note about the blog: a scrap, tacked on low and to the right. */
  .lab-game .qg-notice--blog {
    grid-column: 2 / 4;
    justify-self: end;
    display: grid;
    gap: 6px;
    width: min(100%, 330px);
    margin-top: -6px;
    padding: 18px 22px 20px;
    background-color: var(--q-parch-deep);
  }
  .lab-game .qg-notice--blog::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -7px;
    width: 14px;
    height: 14px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #8d8d8d, #3b3b3b 70%);
    box-shadow: 0 2px 2px rgb(0 0 0 / 50%);
  }
  .lab-game .qg-notice__hand {
    font: 700 27px/1.1 var(--q-hand);
  }
  @media (max-width: 900px) {
    .lab-game .qg-board__notes {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .lab-game .qg-notice:nth-child(n) {
      margin-top: 0;
    }
    .lab-game .qg-notice--blog {
      grid-column: auto;
    }
  }
</style>
