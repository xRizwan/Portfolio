---
// About: a paper house on the left page. Its three shutters lift to show the three traits;
// the lead and body are on a card that stands on the right page.
import { experienceIntro } from '../../data/experience';
import { art, artSrc } from './art';
import Piece from './Piece.astro';

const { about } = experienceIntro;
const shutterPaint = ['var(--pb-sun)', 'var(--pb-red)', 'var(--pb-green)'];
---

<section
  class="pb-spread pb-spread--about"
  id="about"
  data-spread="about"
  data-len="200"
  data-rise="62"
  aria-labelledby="pb-about-title"
>
  <div class="pb-page pb-page--l">
    <Piece name="tree" x={18} y={300} w={120} a={70} at={0} />
    <div
      class="pb-pop pb-house"
      style="--x:22;--y:452;--w:556;--h:371;--a:50;--z:2"
      data-at="0.12"
      data-dur="0.4"
    >
      <img
        class="pb-house__art"
        src={artSrc('house')}
        width={art.house.w}
        height={art.house.h}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <ul class="pb-house__windows">
        {about.traits.map((trait, index) => (
          <li class="pb-win" data-pb-flap data-auto={0.75 + index * 0.1}>
            <button
              class="pb-win__flap pb-paint"
              type="button"
              aria-expanded="false"
              aria-controls={`pb-trait-${index}`}
              style={`--paint:${shutterPaint[index % shutterPaint.length]}`}
            >
              <span>{trait.title}</span>
            </button>
            <div class="pb-win__in" id={`pb-trait-${index}`}>
              <h3>{trait.title}</h3>
              <p>{trait.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <Piece name="cat" x={470} y={560} w={92} a={64} at={0.5} z={4} cat />
    <Piece name="grass" x={20} y={585} w={400} a={72} at={0.45} z={5} />
  </div>

  <div class="pb-page pb-page--r">
    <div
      class="pb-pop pb-card pb-about"
      style="--x:34;--y:486;--w:532;--h:420;--a:50;--z:2"
      data-at="0.3"
      data-dur="0.4"
    >
      <p class="pb-kicker">About me</p>
      <h2 class="pb-h2" id="pb-about-title">
        {about.lead}
      </h2>
      <p class="pb-about__body">{about.body}</p>
    </div>
    <div
      class="pb-pop pb-sign"
      style="--x:60;--y:604;--w:330;--h:64;--a:50;--z:4"
      data-at="0.6"
      data-dur="0.3"
    >
      <p class="pb-note">Lift the shutters on the house.</p>
    </div>
    <Piece name="cat" x={470} y={610} w={84} a={64} at={0.6} z={5} cat class="pb-flip" />
  </div>
</section>

<style is:global>
  .home-book .pb-house {
    position: relative;
    container-type: inline-size;
  }
  .home-book .pb-house__art {
    width: 100%;
  }
  /* The windows sit on the blank wall of the painted house: three across, above the door. */
  .home-book .pb-house__windows {
    position: absolute;
    left: 5.5%;
    right: 5.5%;
    top: 27.5%;
    height: 37%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.2%;
  }
  .home-book .pb-win {
    position: relative;
    perspective: 700px;
  }
  .home-book .pb-win__in {
    height: 100%;
    padding: 7px 9px;
    overflow: hidden;
    border: 2px solid var(--pb-ink);
    border-radius: 3px;
    background: #fffdf6;
    font-size: clamp(10px, 2.35cqw, 13.2px);
    line-height: 1.24;
  }
  .home-book .pb-win__in h3 {
    margin-bottom: 2px;
    font: 800 1.04em/1.1 var(--pb-display);
    color: var(--pb-red);
  }
  .home-book .pb-win__flap {
    display: none;
  }
  /* With scripts the shutters start closed and lift on their top hinge. */
  html.pb-js .home-book .pb-win__flap {
    position: absolute;
    inset: -3px;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 6px;
    border: 2px solid var(--pb-ink);
    border-radius: 3px;
    font: 800 clamp(11px, 2.9cqw, 16px) / 1.05 var(--pb-display);
    text-align: center;
    transform-origin: 50% 0;
    transition: transform 0.7s cubic-bezier(0.3, 1.4, 0.5, 1);
    backface-visibility: hidden;
  }
  html.pb-js .home-book .pb-win__flap::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: 26px;
    height: 7px;
    translate: -50% 0;
    border-radius: 0 0 8px 8px;
    border: 2px dashed rgb(28 37 64 / 55%);
    border-top: 0;
  }
  /* The lifted shutter shows its unpainted back above the window. */
  html.pb-js .home-book .pb-win::before {
    content: '';
    position: absolute;
    inset: -3px;
    z-index: 1;
    border: 2px solid var(--pb-ink);
    border-radius: 3px;
    background: #f1e9d6;
    transform-origin: 50% 0;
    transform: rotateX(0deg);
    transition: transform 0.7s cubic-bezier(0.3, 1.4, 0.5, 1);
    pointer-events: none;
  }
  html.pb-js .home-book .pb-win.is-open .pb-win__flap {
    transform: rotateX(168deg);
  }
  html.pb-js .home-book .pb-win.is-open::before {
    transform: rotateX(168deg);
  }
  html.pb-js .home-book .pb-win__flap:hover {
    transform: rotateX(14deg);
  }
  html.pb-js .home-book .pb-win.is-open .pb-win__flap:hover {
    transform: rotateX(160deg);
  }
  .home-book .pb-about__body {
    font-size: 18px;
  }
  .home-book .pb-about .pb-h2 {
    font-size: clamp(27px, 4vw, 36px);
  }
  .home-book .pb-sign {
    display: none;
  }
  html.pb-js .home-book .pb-sign {
    display: block;
  }
  html.pb-m-book .home-book {
    .pb-about .pb-h2 {
      font-size: 33px;
    }
    .pb-about__body {
      font-size: 17px;
      line-height: 1.42;
    }
    .pb-sign {
      padding: 8px 14px;
      border-radius: 4px;
      background: #fffdf6;
      box-shadow: 0 0 0 1px rgb(28 37 64 / 12%);
      rotate: -1deg;
    }
  }
</style>
