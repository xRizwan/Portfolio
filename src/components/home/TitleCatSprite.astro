---
// Flat chibi cat that walks along RIZZY when the 3D title cats are unavailable (see
// scripts/title-cat-fallback.ts). Hidden by CSS once the 3D cats are ready.
---

<span aria-hidden="true" class="title-cat">
  <span class="title-cat-walk">
    <span class="cat-bubble">mrrp! ♡</span>
    <svg class="cat-sprite" viewBox="0 2 124 88" focusable="false">
      <g class="cat-bodyline">
        <g class="cat-tail">
          <path
            class="c-tail-line"
            d="M34 64 C 18 62 12 46 18 34 C 21 28 28 30 26 36 C 22 44 27 54 38 56"
          ></path>
          <path
            class="c-tail-fill"
            d="M34 64 C 18 62 12 46 18 34 C 21 28 28 30 26 36 C 22 44 27 54 38 56"
          ></path>
        </g>
        <g class="cat-leg leg-b">
          <rect class="c-fur c-far" x="37" y="69" width="11" height="17" rx="5.5"></rect>
        </g>
        <g class="cat-leg leg-a">
          <rect class="c-fur c-far" x="63" y="69" width="11" height="17" rx="5.5"></rect>
        </g>
        <ellipse class="c-fur" cx="54" cy="65" rx="26" ry="15.5"></ellipse>
        <path class="c-stripe" d="M44 52 q3 5 0 9 M53 51 q3 5 0 9 M62 52 q3 5 0 8"></path>
        <ellipse class="c-belly" cx="57" cy="73.5" rx="14" ry="5" style="stroke:none"></ellipse>
        <g class="cat-leg leg-a">
          <rect class="c-fur" x="44" y="70" width="12" height="18" rx="6"></rect>
        </g>
        <g class="cat-leg leg-b">
          <rect class="c-fur" x="70" y="70" width="12" height="18" rx="6"></rect>
        </g>
        <g class="cat-head">
          <path
            class="c-fur"
            d="M66 32 L66 12 Q67 8 71 10 L82 20 Z M92 20 L103 10 Q107 8 107 12 L106 32 Z"
          ></path>
          <path
            class="c-ear-in"
            d="M69.5 26 L69.5 15.5 L77 21.5 Z M97 21.5 L103.5 15.5 L103.5 26 Z"
          ></path>
          <circle class="c-fur" cx="86" cy="42" r="24"></circle>
          <path class="c-stripe" d="M80 21 l1 6 M86 20 l0 7 M92 21 l-1 6"></path>
          <g class="cat-eyes">
            <ellipse class="c-eye" cx="77" cy="44" rx="5" ry="6.2"></ellipse>
            <ellipse class="c-eye" cx="95" cy="44" rx="5" ry="6.2"></ellipse>
            <circle class="c-shine" cx="78.8" cy="41.4" r="2.1"></circle>
            <circle class="c-shine" cx="96.8" cy="41.4" r="2.1"></circle>
            <circle class="c-shine" cx="75.6" cy="46.6" r="1"></circle>
            <circle class="c-shine" cx="93.6" cy="46.6" r="1"></circle>
          </g>
          <ellipse class="c-blush" cx="70" cy="51.5" rx="4.2" ry="2.5"></ellipse>
          <ellipse class="c-blush" cx="102" cy="51.5" rx="4.2" ry="2.5"></ellipse>
          <path class="c-nose" d="M84 49 h4 l-2 2.6 z"></path>
          <path class="c-mouth" d="M81.5 52.8 q2.25 3 4.5 0 q2.25 3 4.5 0"></path>
        </g>
      </g>
    </svg>
  </span>
</span>
