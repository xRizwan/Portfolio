---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getProjects } from '../../lib/collections';
import { projectHref } from '../../lib/content';
import { breadcrumbs, writing } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const origin = Astro.site ?? new URL('http://localhost:4321');
const path = projectHref(entry.id);
---

<EntryLayout
  title={data.title}
  description={data.description}
  type="article"
  published={data.pubDate}
  modified={data.updatedDate}
  jsonLd={[
    writing(origin, {
      type: 'Article',
      title: data.title,
      description: data.description,
      path,
      published: data.pubDate,
      modified: data.updatedDate,
    }),
    breadcrumbs(origin, [
      { name: 'Home', path: '/' },
      { name: 'Projects', path: '/#work' },
      { name: data.title, path },
    ]),
  ]}
  headline={data.headline}
  intro={data.intro}
  eyebrow={data.eyebrow}
  backLink={data.backLink}
  meta={data.meta}
  toc={data.toc}
  tocLinks={data.tocLinks}
  diagram={data.diagram}
  tocLabel="Case study sections"
>
  <Content />
</EntryLayout>
