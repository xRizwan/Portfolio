---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Head back to the home page, the blog, or the experience page."
>
  <main class="wrap" id="main">
    <section class="detail-top">
      <p class="label">404 / Not found</p>
      <h1>This page wandered off.</h1>
      <p class="intro">
        The link may be old, or the page may have moved. Try one of these instead.
      </p>
      <div class="detail-meta">
        <a class="text-link" href="/">
          <span>
            Home <span aria-hidden="true" class="arrow"></span>
          </span>
        </a>
        <a class="text-link" href="/blog/">
          <span>
            Blog <span aria-hidden="true" class="arrow"></span>
          </span>
        </a>
        <a class="text-link" href="/experience/">
          <span>
            Experience <span aria-hidden="true" class="arrow"></span>
          </span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
